    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH picked AS (\n    SELECT id\n    FROM leads\n    WHERE status = 'new'\n      AND retry_count < 3\n      AND website_url IS NOT NULL\n      AND website_url <> ''\n    ORDER BY created_at ASC\n    LIMIT {{ $('config').first().json.batchSize }}\n    FOR UPDATE SKIP LOCKED\n)\n\nUPDATE leads l\nSET\n    status = 'enriching',\n    updated_at = NOW()\nFROM picked\nWHERE l.id = picked.id\n\nRETURNING\n    l.id,\n    l.business_name,\n    l.website_url,\n    l.retry_count,\n    l.city,\n    l.category;\n",
        "options": {}
      },
