      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Branch B: PageSpeed single call production-ready — 2026-06-20 UTC+5\nconst GKEY = $env.GOOGLE_API_KEY;\nconst http = this.helpers.httpRequest;\nconst it = $json;\nconst base = (it.website_url || '').trim();\n\nif (!base || !GKEY) {\n  return { id: it.id, website_url: base, pagespeed_score: null, seo_score: null, mobile_score: null, pagespeed_error: !GKEY ? 'missing GOOGLE_API_KEY env var' : 'no_url' };\n}\n\nlet ps = null, seo = null, acc = null, pagespeed_error = null;\n\ntry {\n  const url =\n    'https://www.googleapis.com/pagespeedonline/v5/runPagespeed' +\n    '?url='      + encodeURIComponent(base) +\n    '&key='      + encodeURIComponent(GKEY) +\n    '&strategy=mobile' +\n    '&category=performance' +\n    '&category=seo' +\n    '&category=accessibility';\n\n  const r = await http({ method: 'GET', url, json: true, timeout: 90000 });\n\n  const cats = r?.lighthouseResult?.categories || {};\n  ps  = cats.performance   ? Math.round(cats.performance.score   * 100) : null;\n  seo = cats.seo           ? Math.round(cats.seo.score           * 100) : null;\n  acc = cats.accessibility ? Math.round(cats.accessibility.score * 100) : null;\n\n} catch (e) {\n  pagespeed_error = e.message?.includes('timeout') ? 'timeout' : (e.message || 'failed');\n}\n\nreturn { id: it.id, website_url: base, pagespeed_score: ps, seo_score: seo, mobile_score: acc, pagespeed_error };"
      },
