# Copy this file to .env.local and fill real values
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# RECOMMENDED — n8n Webhook Production URL (WF1)
# Example: http://localhost:5678/webhook/wf1-find-leads
N8N_WF1_WEBHOOK_URL=

# Optional fallback — Form URL (can create empty running campaigns)
N8N_WF1_FORM_URL=

# WF2 — Research / Enrichment webhook
N8N_WF2_WEBHOOK_URL=

# WF3 — AI Audit + Email Draft webhook
N8N_WF3_WEBHOOK_URL=
