# ─────────────────────────────────────────────────────────────
# Atrium Reach — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sale_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_database_password_here

# ── n8n Workflow Webhooks ──────────────────────────────────
# Replace localhost with your production n8n server URL.
# Example: https://n8n.yourdomain.com/webhook/wf1-find-leads
N8N_WF1_WEBHOOK_URL=http://localhost:5678/webhook/wf1-find-leads
N8N_WF1_FORM_URL=

N8N_WF2_WEBHOOK_URL=http://localhost:5678/webhook/wf2-research
N8N_WF3_WEBHOOK_URL=http://localhost:5678/webhook/wf3-ai-draft
N8N_WF4_WEBHOOK_URL=http://localhost:5678/webhook/wf4-send

# ── Auth — Single Admin ────────────────────────────────────
# Change ALL three before deploying to production.
# AUTH_SECRET: run `openssl rand -hex 32` to generate a strong secret.
AUTH_USERNAME=your_admin_username
AUTH_PASSWORD=your_strong_password_here
AUTH_SECRET=generate_with__openssl_rand_-hex_32
