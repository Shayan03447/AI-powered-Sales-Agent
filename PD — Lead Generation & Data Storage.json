    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Handle all Apify response structures\nlet businesses;\nif (Array.isArray(raw)) {\n  businesses = raw;\n} else if (Array.isArray(raw.items)) {\n  businesses = raw.items;\n} else {\n  businesses = [raw];\n}\n\n// Split + Normalize in one step\nreturn businesses.map(business => ({\n  json: {\n    // Identity\n    external_id:   business.placeId || business.phoneUnformatted || '',\n    source:        'gmb',\n\n    // Core business info\n    business_name: business.title || '',\n    category:      business.categoryName || '',\n    phone:         business.phone || '',\n    address:       business.street || business.address || '',\n    city:          business.city || '',\n    state:         business.state || '',\n    country:       business.countryCode || 'AU',\n    website_url:   business.website || '',\n\n    // Performance (may be null — filled by WF2 later)\n    rating:        business.totalScore || null,\n    review_count:  business.reviewsCount || null,\n\n    // Pipeline\n    status:        'new',\n    search_query:  `${business.categoryName || ''} in ${business.city || ''}`\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
