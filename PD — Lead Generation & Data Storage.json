        "operation": "executeQuery",
        "query": "INSERT INTO leads (\n  external_id,\n  business_name,\n  phone,\n  address,\n  city,\n  state,\n  country,\n  website_url,\n  category,\n  source,\n  status,\n  rating,\n  review_count,\n  search_query,\n  created_at,\n  updated_at\n) VALUES (\n  '{{ $json.external_id }}',\n  '{{ $json.business_name.replace(/'/g, \"''\") }}',\n  '{{ $json.phone }}',\n  '{{ $json.address.replace(/'/g, \"''\") }}',\n  '{{ $json.city }}',\n  '{{ $json.state }}',\n  '{{ $json.country }}',\n  '{{ $json.website_url }}',\n  '{{ $json.category }}',\n  '{{ $json.source }}',\n  '{{ $json.status }}',\n  {{ $json.rating ?? 'NULL' }},\n  {{ $json.review_count ?? 'NULL' }},\n  '{{ $json.search_query.replace(/'/g, \"''\") }}',\n  NOW(),\n  NOW()\n) ON CONFLICT (external_id) DO NOTHING;",
        "options": {}
