    {
      "parameters": {
        "jsCode": "const cfg = $('Code — Expand Sources1').item.json;\nconst places = $input.first().json.places || [];\n\nif (!places.length) {\n  return [];\n}\n\nconst limit = Number(cfg.limit) || 50;\n\nreturn places.slice(0, limit).map((p) => {\n  const rawId = (p.id || '').replace('places/', '');\n  const website = (p.websiteUri || '').trim();\n  const hasWebsite = website.length > 0;\n\n  return {\n    json: {\n      external_id: `gmb_${rawId}`,\n      source: 'gmb',\n      business_name: p.displayName?.text || '',\n      category: p.primaryType || '',\n      phone: p.nationalPhoneNumber || '',\n      address: p.formattedAddress || '',\n      city: cfg.city || '',\n      state: '',\n      country: cfg.country || 'AU',\n      website_url: website,\n      google_url: rawId\n        ? `https://www.google.com/maps/place/?q=place_id:${rawId}`\n        : '',\n      rating: p.rating ?? null,\n      review_count: p.userRatingCount ?? null,\n      search_query: cfg.search_query || '',\n      campaign_id: cfg.campaign_id,\n      status: hasWebsite ? 'new' : 'no_website',\n      failure_reason: hasWebsite ? null : 'No website URL in Google Maps listing',\n    },\n  };\n});"
      },
