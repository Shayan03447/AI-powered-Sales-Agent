    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (\n  external_id,\n  source,\n  business_name,\n  category,\n  phone,\n  address,\n  city,\n  state,\n  country,\n  website_url,\n  google_url,\n  rating,\n  review_count,\n  search_query,\n  campaign_id,\n  status,\n  failure_reason,\n  created_at,\n  updated_at\n) VALUES (\n  '{{ ($json.external_id || \"\").substring(0, 255).replace(/'/g, \"''\") }}',\n  '{{ ($json.source || \"\").substring(0, 50).replace(/'/g, \"''\") }}',\n  '{{ ($json.business_name || \"\").substring(0, 255).replace(/'/g, \"''\") }}',\n  '{{ ($json.category || \"\").substring(0, 255).replace(/'/g, \"''\") }}',\n  '{{ ($json.phone || \"\").substring(0, 50).replace(/'/g, \"''\") }}',\n  '{{ ($json.address || \"\").replace(/'/g, \"''\") }}',\n  '{{ ($json.city || \"\").substring(0, 100).replace(/'/g, \"''\") }}',\n  '{{ ($json.state || \"\").substring(0, 100).replace(/'/g, \"''\") }}',\n  '{{ ($json.country || \"\").substring(0, 10).replace(/'/g, \"''\") }}',\n  '{{ ($json.website_url || \"\").replace(/'/g, \"''\") }}',\n  '{{ ($json.google_url || \"\").replace(/'/g, \"''\") }}',\n  {{ $json.rating !== null && $json.rating !== undefined && $json.rating !== \"\" ? $json.rating : \"NULL\" }},\n  {{ $json.review_count !== null && $json.review_count !== undefined && $json.review_count !== \"\" ? $json.review_count : \"NULL\" }},\n  '{{ ($json.search_query || \"\").replace(/'/g, \"''\") }}',\n  {{ $json.campaign_id ? $json.campaign_id : \"NULL\" }},\n  '{{ ($json.status || \"new\").substring(0, 50).replace(/'/g, \"''\") }}',\n  {{ $json.failure_reason ? \"'\" + String($json.failure_reason).replace(/'/g, \"''\") + \"'\" : \"NULL\" }},\n  NOW(),\n  NOW()\n)\nON CONFLICT (external_id) DO NOTHING;",
        "options": {}
      },
