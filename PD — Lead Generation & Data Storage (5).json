    {
      "parameters": {
        "jsCode": "const cfg = $('Set Search Parameters1').first().json;\nconst campaignId = $('Postgres — Create Campaign1').first().json.id;\nconst leads = $('Code — Deduplicate').all();\n\nlet rawCount = 0;\ntry { rawCount += $('Code — Normalize GMB1').all().length; } catch(e) {}\ntry { rawCount += $('Code — Normalize Yelp1').all().length; } catch(e) {}\n\nconst startedAt = cfg.started_at\n  ? new Date(cfg.started_at).getTime()\n  : Date.now();\n\nreturn [{\n  json: {\n    campaign_id: campaignId,\n    leads_found: rawCount,\n    leads_processed: leads.length,\n    leads_failed: Math.max(0, rawCount - leads.length),\n    duration_ms: Date.now() - startedAt,\n    notes: `WF1 lead_generation | ${cfg.search_query} | source=${cfg.source}`,\n  },\n}];"
      },
