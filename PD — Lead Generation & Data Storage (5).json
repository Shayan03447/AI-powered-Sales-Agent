{
  "name": "PD — Lead Generation & Data Storage",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Map();\n\nfor (const item of items) {\n  const name = (item.json.business_name || '').toLowerCase().trim();\n  const city = (item.json.city || '').toLowerCase().trim();\n  const key = `${name}||${city}`;\n\n  if (!seen.has(key)) {\n    seen.set(key, item);\n  } else {\n    // Prefer GMB record over Yelp — GMB includes website_url\n    const existing = seen.get(key);\n    if (item.json.source === 'gmb' && existing.json.source !== 'gmb') {\n      seen.set(key, item);\n    }\n  }\n}\n\nreturn Array.from(seen.values());"
      },
