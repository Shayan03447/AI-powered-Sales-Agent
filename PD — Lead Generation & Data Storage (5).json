    {
      "parameters": {
        "jsCode": "const cfg = $('Code — Expand Sources1').item.json;\nconst businesses = $input.first().json.businesses || [];\n\nif (!businesses.length) return [];\n\nreturn businesses.map((b) => ({\n  json: {\n    external_id: `yelp_${b.id}`,\n    source: 'yelp',\n    business_name: b.name || '',\n    category: (b.categories || []).map((c) => c.title).join(', '),\n    phone: b.display_phone || b.phone || '',\n    address: (b.location?.display_address || []).join(', '),\n    city: b.location?.city || cfg.city,\n    state: b.location?.state || '',\n    country: b.location?.country || cfg.country,\n    website_url: b.url || '',\n    rating: b.rating ?? null,\n    review_count: b.review_count ?? null,\n    status: b.url ? 'new' : 'no_website',\n    failure_reason: b.url ? null : 'No website URL found in Yelp listing',\n    search_query: cfg.search_query,\n    campaign_id: cfg.campaign_id,\n    yelp_id: b.id,\n  },\n}));"
      },
